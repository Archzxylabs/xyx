{
  "name": "xyx-monad",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test packages/monad/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:contracts": "forge test --root packages/contracts -vv",
    "build:contracts": "forge build --root packages/contracts",
    "dev:web": "next dev apps/web",
    "build:web": "next build apps/web",
    "demo": "node --env-file=.env --import tsx scripts/monad-demo.ts",
    "publish:manifest": "node --env-file=.env --import tsx scripts/publish-manifest.ts",
    "claim:refund": "node --env-file=.env --import tsx scripts/claim-refund.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "next": "^16.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.37.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
