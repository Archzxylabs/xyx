{
  "name": "xyx-monad",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run build:contracts && node --import tsx --test packages/monad/test/*.test.ts",
    "sync:abi": "node --import tsx scripts/sync-abi.ts",
    "test:abi:drift": "node --import tsx scripts/test-abi-drift.ts",
    "typecheck": "tsc --noEmit",
    "test:contracts": "forge test --root packages/contracts -vv --match-path 'test/XYXDeliveryProtocol*.t.sol'",
    "test:contracts:legacy": "forge test --root packages/contracts -vv --match-path 'test/{C1Hardening,MonadLifecycle}*.t.sol'",
    "test:contracts:all": "npm run test:contracts && npm run test:contracts:legacy",
    "build:contracts": "forge build --root packages/contracts",
    "dev:web": "node scripts/web-entry.mjs dev apps/web",
    "build:web": "node scripts/web-entry.mjs build apps/web",
    "demo": "echo 'LEGACY_SCRIPT_RETIRED: use canonical XYXDeliveryProtocol flow'",
    "publish:manifest": "echo 'LEGACY_SCRIPT_RETIRED: use canonical XYXDeliveryProtocol flow'",
    "claim:refund": "node --env-file=.env --import tsx scripts/claim-refund.ts",
    "readiness": "node --import tsx scripts/deployment-readiness.ts",
    "setup:live": "node --import tsx scripts/setup-live.ts",
    "workflow:triage": "node --env-file-if-exists=.env.workflow.local --import tsx scripts/jev-workflow-triage.ts",
    "workflow:supervise": "node --env-file-if-exists=.env.workflow.local --import tsx scripts/jev-build-supervisor.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "next": "^16.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.37.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
