# XYX Monad Testnet environment template
#
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit `.env`.
# Monad Testnet only. Chain ID 10143.
# Buyer, provider, attestor, and relayer keys must stay separate accounts.

# ---------------------------------------------------------------
# Canonical deployment addresses (Monad Testnet, chain 10143)
#
# Fill these in only after a real deployment is observed on-chain.
# Every address must be non-zero and exactly 20 bytes. A zero address
# makes /demo and the wallet UI render a configuration-required state.
# ---------------------------------------------------------------
XYX_PROTOCOL_ADDRESS=
XYX_PAYMENT_TOKEN_ADDRESS=
XYX_REGISTRY_ADDRESS=
XYX_P256_VERIFIER_ADDRESS=

# Browser-facing configuration for the connected-wallet product UI. These
# values are public and inlined at build time; NEVER put paid RPC API keys,
# credentials, or private data in NEXT_PUBLIC_* values. Both public RPC hosts
# must be distinct. Keep these deployment addresses aligned with the verified
# server-side addresses above. The root web scripts load root .env explicitly.
NEXT_PUBLIC_XYX_CHAIN_ID=10143
NEXT_PUBLIC_XYX_PROTOCOL_ADDRESS=
NEXT_PUBLIC_XYX_REGISTRY_ADDRESS=
NEXT_PUBLIC_XYX_P256_VERIFIER_ADDRESS=
NEXT_PUBLIC_XYX_PAYMENT_TOKEN_ADDRESS=
NEXT_PUBLIC_XYX_RP_ID=
NEXT_PUBLIC_XYX_RPC_URL=
NEXT_PUBLIC_XYX_SECONDARY_RPC_URL=

# Server-side persistent encrypted handoff store. The server keeps ciphertext
# only; AES keys stay in URL fragments and never reach the API. When omitted,
# the standalone app uses <repository>/.xyx-data/handoffs.sqlite.
XYX_HANDOFF_DATABASE_PATH=

# ---------------------------------------------------------------
# Public read-only RPC (dual-RPC verification needs two nodes)
# Both must be set for `npm run readiness` to query the chain. The
# harness builds TWO separate clients, one per endpoint, reads every
# chain check from BOTH, and requires them to agree — same chain ID
# (10143), the same bytecode at each address, the same decimals().
# In the JSON report that field is `expectedChainId` (a constant, 10143,
# printed even by `--offline`) while `observedChainIds.primary` and
# `observedChainIds.secondary` hold what each live endpoint actually
# returned, or null when it was not queried. `--offline` prints both
# observed values as null and never 10143.
# Pointing both at the same host, or supplying one endpoint twice,
# is not redundancy: the run reports RPC_ENDPOINTS_IDENTICAL /
# RPC_PROBE_REUSED / LIVE_DUAL_RPC_PROBE_REQUIRED and stays NOT_READY.
# A run that cannot prove it read two independent nodes never
# reports READY_FOR_EXPLICIT_BROADCAST_AUTHORIZATION.
# ---------------------------------------------------------------
XYX_RPC_URL=https://testnet-rpc.monad.xyz
XYX_SECONDARY_RPC_URL=
XYX_PRIMARY_RPC_URL=

# Payment token on Monad Testnet (USDC).
MONAD_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3

# Address of the deploying keystore account (the signer used with
# `--account deployer-keystore` in DeployXYXDelivery.s.sol). This is a
# public address only — never a private key. Preflight reads its
# payment-token balance from both RPCs and refuses to report READY while
# that balance is zero or the two endpoints disagree.
XYX_DEPLOY_FUNDER_ADDRESS=

# ---------------------------------------------------------------
# Canonical manifest shown on the read-only /demo page
# ---------------------------------------------------------------
XYX_CANONICAL_MANIFEST_URI=
XYX_CANONICAL_MANIFEST_HASH=

# ---------------------------------------------------------------
# Passkey / WebAuthn binding
# ---------------------------------------------------------------
XYX_RP_ID=
VERDICT_LIFETIME=300
# Commit being deployed (40 hex chars). Set at deploy time, e.g.
#   DEPLOY_COMMIT=$(git rev-parse HEAD) forge script ...
# Never committed; recorded in the deployment provenance.
DEPLOY_COMMIT=
# Read-only preflight: `npm run readiness`. Monad charges gas_limit *
# price_per_gas, so a large buffer is a direct overpayment. 1000 bps (10%) is
# the maximum the harness accepts; leave empty for no buffer.
XYX_GAS_BUFFER_BPS=
# Optional gas estimate (in gas units) for the buffer to be checked against.
XYX_GAS_ESTIMATE=

# ---------------------------------------------------------------
# Evidence storage (public gateway for /demo, kubo or Pinata for writes)
# ---------------------------------------------------------------
IPFS_PROVIDER=kubo
IPFS_API_URL=http://127.0.0.1:5001
IPFS_AUTHORIZATION=
# Public read-only gateway used by /demo. Falls back to IPFS_GATEWAY_URL.
IPFS_PUBLIC_GATEWAY_URL=
# Optional public Pinata mode: use IPFS_PROVIDER=pinata and set both below.
PINATA_JWT=
IPFS_GATEWAY_URL=

# ---------------------------------------------------------------
# Role keys (separate accounts, never shared, never committed)
# ---------------------------------------------------------------
MONAD_BUYER_PRIVATE_KEY=
MONAD_PROVIDER_PRIVATE_KEY=
MONAD_ATTESTOR_PRIVATE_KEY=
MONAD_RELAYER_PRIVATE_KEY=
MONAD_MAX_TX_GAS=
