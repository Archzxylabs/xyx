{
  "name": "@xyx/monad",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./legacy": {
      "types": "./src/legacy.ts",
      "import": "./src/legacy.ts"
    }
  }
}
